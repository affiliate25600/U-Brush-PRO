        <main>
            <div class="main-top">
                <a href="/track" title="Back to track">
                    <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="var(--secondary)"><path d="m313-440 224 224-57 56-320-320 320-320 57 56-224 224h487v80H313Z"/></svg>
                    Back
                </a>
                <h1>Order <%= orderId %></h1>
            </div>
            <h2>Tracking</h2>
            <h3 class="order-tracking-est-arrival">Est. arrival: <%= orderArrival %></h3>
            <div class="order-tracking status-0" id="order-tracking">
                <div class="tracking-status-text">
                    <p>Order Created</p>
                    <p>It's on its way</p>
                    <p>It's coming today</p>
                    <p>Delivered</p>
                </div>
                <div class="tracking-status-bar">
                    <div class="tracking-status-bar-section">
                        <div class="tracking-status-bar-line right"></div>
                        <svg class="status-complete" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="var(--text-muted)"><path d="m424-296 282-282-56-56-226 226-114-114-56 56 170 170Zm56 216q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z"/></svg>
                    </div>
                    <div class="tracking-status-bar-section">
                        <div class="tracking-status-bar-line left"></div>
                        <div class="tracking-status-bar-line right"></div>
                        <svg class="status-complete" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="var(--text-muted)"><path d="m424-296 282-282-56-56-226 226-114-114-56 56 170 170Zm56 216q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z"/></svg>
                    </div>
                    <div class="tracking-status-bar-section">
                        <div class="tracking-status-bar-line left"></div>
                        <div class="tracking-status-bar-line right"></div>
                        <svg class="status-complete" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="var(--text-muted)"><path d="m424-296 282-282-56-56-226 226-114-114-56 56 170 170Zm56 216q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z"/></svg>
                    </div>
                    <div class="tracking-status-bar-section">
                        <div class="tracking-status-bar-line left"></div>
                        <svg class="status-complete" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="var(--text-muted)"><path d="m424-296 282-282-56-56-226 226-114-114-56 56 170 170Zm56 216q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z"/></svg>
                    </div>
                </div>
            </div>

            <h2>Info</h2>
            <div class="order-info">
                <div class="order-info-group">
                    <h4>Order:</h4>
                    <p><%= orderQuantity %> x U Brush PRO</p>
                </div>
                <div class="order-info-group">
                    <h4>Deliver to:</h4>
                    <p><%= orderCity %>, <%= orderState %></p>
                </div>
            </div>
        </main>

        <footer>
            <div class="footer-links">
                <a href="/" title="Home">Home</a>
                <a href="/about" title="About">About</a>
                <a href="/contact" title="Contact">Contact</a>
                <a href="/track" title="Contact">Track package</a>
                <a href="/U-Brush-PRO" title="Buy U Brush PRO">Buy</a>
            </div>
            <div class="footer-copyright">
                <p>Built by <a href="https://16bitdevelopment.com" target="_blank">16 Bit Development</a></p>
                <p>&copy; U Brush PRO <span id="date-year"></span></p>
            </div>
        </footer>

        <script>
            const yearEl = document.getElementById("date-year");
            yearEl.innerHTML = new Date().getFullYear();
        </script>

        <script>
            const orderStatus = "<%= orderStatus %>";

            const orderTrackingEl = document.getElementById("order-tracking");

            if (orderStatus === "0") {
                orderTrackingEl.classList.add("status-0");
            } else if (orderStatus === "1") {
                orderTrackingEl.classList.add("status-0");
                orderTrackingEl.classList.add("status-1");
            } else if (orderStatus === "2") {
                orderTrackingEl.classList.add("status-0");
                orderTrackingEl.classList.add("status-1");
                orderTrackingEl.classList.add("status-2");
            } else if (orderStatus === "3") {
                orderTrackingEl.classList.add("status-0");
                orderTrackingEl.classList.add("status-1");
                orderTrackingEl.classList.add("status-2");
                orderTrackingEl.classList.add("status-3");
            }
        </script>
    </body>
</html>