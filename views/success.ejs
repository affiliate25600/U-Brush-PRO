        <script>
            const sessionId = "<%= sessionId %>";

            const paymentStatusEl = document.getElementById("payment-status");
            const paymentStatusTextEl = document.getElementById("status-text");
            const orderIdEl = document.getElementById("order-id");
            const viewOrderEl = document.getElementById("view-order");

            async function checkStatus() {
                const res = await fetch(`/payment-status?session_id=${sessionId}`);
                const data = await res.json();

                if (data.paid) {
                    document.title = "Payment successful! | U Brush PRO";

                    paymentStatusEl.classList.add("complete");

                    paymentStatusTextEl.textContent = "Payment successful!";

                    orderIdEl.textContent = data.orderId;

                    viewOrderEl.setAttribute("href", `/track/${data.orderId}`);
                } else {
                    setTimeout(checkStatus, 1000);
                }
            }

            checkStatus();
        </script>
