            buyBtn.addEventListener("click", (event) => {
                const validInputResult = isValidInputs(1);
                if (validInputResult !== "") {
                    productErrorMsg.innerHTML = validInputResult;

                    return;
                }
                
                productErrorMsg.innerHTML = "";

                const orderTax = Math.floor(((productQuantityEl.value * 35) * 0.029 + 0.30) * 100) / 100;
                const orderTotal = (parseInt(productQuantityEl.value) * 35) + orderTax;

                orderItemsEl.innerHTML = `${productQuantityEl.value} x $35`;
                orderTaxEl.innerHTML = `$${orderTax}`;
                orderTotalEl.innerHTML = `USD $${orderTotal}`;

                mainEl.style.display = "none";

                deliveryEl.style.display = "flex";
            });

            backToMainEl.addEventListener("click", (event) => {
                mainEl.style.display = "grid";

                deliveryEl.style.display = "none";
            });

            createOrderBtn.addEventListener("click", (event) => {
                const validInputResult = isValidInputs();
                if (validInputResult !== "") {
                    orderErrorMsg.innerHTML = validInputResult;

                    return;
                }

                orderErrorMsg.innerHTML = "";

                fetch("/buy-u-brush-pro", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        quantity: productQuantityEl.value,
                        name: orderNameEl.value,
                        email: orderEmailEl.value,
                        country: orderCountryEl.value,
                        address: orderAddressEl.value,
                        postcode: orderPostcodeEl.value,
                        city: orderCityEl.value,
                        state: orderStateEl.value
                    })
                })
                .then((response) => response.text())
                .then((data) => {
                    const parsedData = JSON.parse(data)

                    if (!parsedData[0]) {
                        productErrorMsg.innerHTML = parsedData[1];

                        backToMainEl.click();
                    } else {
                        window.location.href = parsedData[1];
                    }
                });
            });
