            const orderAddressEl = document.getElementById("address");
            const orderPostcodeEl = document.getElementById("postcode");
            const orderCityEl = document.getElementById("city");
            const orderStateEl = document.getElementById("state");

            const orderItemsEl = document.getElementById("order-items");
            const orderTaxEl = document.getElementById("order-tax");
            const orderTotalEl = document.getElementById("order-total");

            const productErrorMsg = document.getElementById("product-error-msg");
            const orderErrorMsg = document.getElementById("order-error-msg");

            if (stockLevel > 0) {
                stockLevelEl.innerHTML = stockLevel + ' In Stock';

                for (let i = 0; i < stockLevel; i += 1) {
                    if (i > 4) {
                        break;
                    }
                    productQuantityEl.children[i].style.display = "inline";
                }
            } else {
                stockLevelEl.innerHTML = 'No Stock';
                stockLevelEl.classList.add("no-stock");

                productQuantityEl.remove();

                buyProductEl.remove();
            }

            function isValidInputs(type) {
                if (parseInt(productQuantityEl.value) > stockLevel) {
                    return "Please enter a valid quantity";
                }

                if (type === 1) {
                    if (/^[1-5]$/.test(productQuantityEl.value)) {
                        return "";
                    } else {
                        return "Please enter a valid quantity";
                    }
                }

                const validInputs = [
                    {
                        string: productQuantityEl.value,
                        regex: /^[1-5]$/,
                        msg: "Please enter a valid quantity"
                    }, {
                        string: orderNameEl.value,
                        regex: /^\p{L}+(?:[ '-]\p{L}+)*$/u,
                        msg: "Please enter a valid name"
                    }, {
                        string: orderEmailEl.value,
                        regex: /^(?!.*\.\.)[\p{L}0-9._%+-]+@[\p{L}0-9.-]+\.[\p{L}]{2,}$/u,
                        msg: "Please enter a valid email"
                    }, {
                        string: orderAddressEl.value,
                        regex: /^[\p{L}\d][\p{L}\d\s.,'’\-/#]{2,}$/u,
                        msg: "Please enter a valid address"
                    }, {
                        string: orderPostcodeEl.value,
                        regex: /^[\p{L}\d][\p{L}\d\s\-]{2,9}$/u,
                        msg: "Please enter a valid postcode"
                    }, {
                        string: orderCityEl.value,
                        regex: /^[\p{L}][\p{L}\s.'’\-]{1,}$/u,
                        msg: "Please enter a valid city/suburb"
                    }, {
                        string: orderStateEl.value,
                        regex: /^[\p{L}][\p{L}\s.'’\-]{1,}$/u,
                        msg: "Please enter a valid state/territory"
                    }
                ];

